# DoseMate — Smart Medication Companion Environment Variables
# If not configured, DoseMate saves real user data locally in browser storage.
# Configure Supabase credentials below for multi-device cloud synchronization.

# Supabase Cloud Database & Auth Configuration (Optional)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Application Configuration
NEXT_PUBLIC_APP_NAME="DoseMate"
NEXT_PUBLIC_APP_URL=http://localhost:3000
